{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "RaFlow",
  "version": "0.1.0",
  "identifier": "com.ai-bootcamp.raflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RaFlow 语音输入",
        "width": 800,
        "height": 600,
        "resizable": true,
        "hiddenTitle": false,
        "titleBarStyle": "Visible",
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.elevenlabs.io; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Real-time voice input tool powered by ElevenLabs",
    "longDescription": "RaFlow is a cross-platform voice input tool with low-latency speech-to-text powered by ElevenLabs Scribe v2. Features global hotkey support, multi-language recognition, and intelligent text insertion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AI Bootcamp Team",
    "copyright": "Copyright © 2026 AI Bootcamp Team",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "globalShortcut": {},
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ai-bootcamp/raflow/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQjkRQjAxODcyNjY5RTQKUldTRTRNQVFCNitvblNjZnpLTnZJSHhRTEdSdG5kZjhIc1JyQTRVMm42VjNwQlJjdE1Xbm8xN0wK"
    }
  }
}
